# Save a copy of this file as .env in this directory, and then update that.
# DO NOT MODIFY sample.env IN PLACE, as it will be ignored.

# This file is used for local development (`npm start`).
# See also sample.env in the dist directory (for deploying, and the configuration on the server).

# SERVER_PORT is the port the server listens on.
SERVER_PORT=7777

# TZ is the default time zone for devices without a `timezone` in devices.yaml, e.g.
#   TZ=Europe/Berlin
TZ=

# TOKEN_SECRET is used to derive the devices' tokens and to sign login sessions. Generate one with
#   openssl rand -base64 32
TOKEN_SECRET=
