# Save a copy of this file as .env in this directory, and then update that.
# DO NOT MODIFY sample.env IN PLACE, as it will be ignored.

# This file is used for deploying to the remote server, and is copied there as the server's
# configuration.

# SERVER_PORT is the port on the host that the server is reachable at, and that Caddy forwards to.
# It must be unique among the sites on the server. Inside the container the server always uses 7777.
SERVER_PORT=7777

# SERVER_DOMAIN is the address the server is reached at. Caddy is configured to serve this domain
# with HTTPS, forwarding to SERVER_PORT.
SERVER_DOMAIN=https://trmnl.example.com

# CONTACT is how the services this server fetches from (Transitous, MVG, OpenFreeMap, …) can reach
# whoever runs it, sent in its User-Agent: e.g. an email address. Transitous' usage policy asks for
# one.
CONTACT=

# TZ is the default time zone for devices without a `timezone` in devices.yaml, e.g.
#   TZ=Europe/Berlin
TZ=

# TOKEN_SECRET is used to derive the devices' tokens and to sign login sessions. Generate one with
#   openssl rand -base64 32
# Changing it logs everyone out and means pairing every device again.
TOKEN_SECRET=

# The following items are used for deploying to a remote server (`npm run deploy`).
# The host should be an IP address/domain name that accepts ssh connections, or the name of a host
# as specified in ~/.ssh/config .
# All the other parameters are optional. You must wrap any values containing dollars, spaces or
# other special character in single quotes, as these options will be interpreted by bash directly.
# If DEPLOY_KEYPAIR is a relative path, it should be given relative to the parent directory, the
# root of the repository.
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_KEYPAIR=
DEPLOY_DIR='trmnl'
