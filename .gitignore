.DS_Store
node_modules
devices.yaml

# Build output: only the deployment files in dist/ are tracked
/dist/*
!/dist/Dockerfile
!/dist/docker-compose.yml
!/dist/.dockerignore
!/dist/.rsyncignore
!/dist/sample.env

# env files and key files
*.env
!sample.env
*.pem

# Screen development server build (scripts/dev)
/.dev/

# Test build (scripts/test)
/.test/

# The dev server's own state, e.g. its Strava tokens (scripts/dev)
/.dev-state/
