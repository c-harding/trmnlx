#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

if [ ! -f dist/.env ]; then
  echo 'dist/.env does not exist.' >&2
  echo 'Create it by copying dist/sample.env, and fill in the deploy settings.' >&2
  exit 1
fi

set -a
. dist/.env
set +a

if [ -z "$DEPLOY_HOST" ]; then
  echo 'DEPLOY_HOST is not set.' >&2
  echo 'Please add this to dist/.env or provide it on the command line.' >&2
  exit 1
fi

if [ -z "$DEPLOY_USER" ]; then
  DEPLOY_TARGET="$DEPLOY_HOST"
else
  DEPLOY_TARGET="$DEPLOY_USER@$DEPLOY_HOST"
fi

# DEPLOY_SSH_ARGS: an array of args for ssh for passing the keypair
# DEPLOY_FLAG: an arg for rsync for passing the keypair
if [ -z "$DEPLOY_KEYPAIR" ]; then
  DEPLOY_FLAG=""
  DEPLOY_SSH_ARGS=()
else
  DEPLOY_FLAG=-i\'${DEPLOY_KEYPAIR//\'/\'\'}\'
  DEPLOY_SSH_ARGS=(-i "$DEPLOY_KEYPAIR")
fi

if [ "$0" = "$BASH_SOURCE" ]; then
  ssh "${DEPLOY_SSH_ARGS[@]}" "$DEPLOY_TARGET" "$@"
fi
