    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "cookie-parser": "^1.4.7",
    "d3-contour": "^4.0.2",
    "express": "^5.3.0",
    "opening_hours": "^3.15.0",
    "pbf": "^5.1.2",
    "preact": "^11.0.1",
    "satori": "^0.47.1",
