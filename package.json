    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "scripts/test"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/d3-contour": "^3.0.6",
    "@types/express": "^5.0.6",
