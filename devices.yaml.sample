# Copy to devices.yaml and fill in your devices. devices.yaml is gitignored.
# defaultScreen: placeholder  # The screen for devices that don't name one, and while no playlist entry applies (default: placeholder, or the first screen found)
# location: { country: de, state: Bayern, lat: 48.14, lon: 11.58 }  # For public and school holidays (PH, SH) in `when`, and with lat and lon for sunrise and sunset; a device can have its own
# playlists:  # Named playlists, for devices (playlist: travel) and other playlists to use
#   travel:
#     - screen: journeys
#       inputs:
#         routes:
#           - Marienplatz -> München Ost
devices:
  - mac: "AA:BB:CC:DD:EE:FF"  # Quote MACs: some parsers read unquoted all-digit values as numbers
    username: kitchen
    password: change-me
    # timezone: Europe/Berlin  # Defaults to TZ, then UTC
    # location: { country: at, state: Tirol }  # Overrides the top-level location, for holidays in `when`
    # refreshRate: 900  # Seconds between polls, at least 60
    # screen: mvg-departures  # Which screen this device shows, with its default inputs; overrides defaultScreen
    # playlist:  # Instead of screen: what the device shows, with inputs (or the name of a playlist above)
    #   - screen: mvg-departures
    #     inputs:
    #       station: Marienplatz
    #     duration: 10m  # How long before moving on to the next entry (90s, 10m, 1h, 1h30m); without it, until a button press
    #     when: Mo-Fr 06:30-09:00; PH off  # When it applies, in OpenStreetMap's opening_hours syntax; without it, always
    #   - screen: map
    #     inputs:
    #       title: München
    #       lat: 48.1374
    #       lon: 11.5755
    #       zoom: 12.1  # Fractions allowed; drawn once and kept in state/maps/
    #   - screen: map
    #     inputs:
    #       title: Innsbruck
    #       lat: 47.2687
    #       lon: 11.3933
    #       zoom: 13  # A smaller city: closer in
    #   - playlist: travel  # Includes a named playlist; just `- travel` does too
    #     duration: 5m  # For the included entries without their own
    #   - screen: placeholder
    #     when: otherwise  # When nothing else in this list applies
    # playlists:  # Others to switch to on the screen page, after this playlist (offered as default)
    #   evening:  # Each like playlist: a list of entries, or the name of a playlist above
    #     - screen: journeys
    #   maps: travel
    # playlists: [travel, maps]  # Or just playlists above, each offered under its own name
    # fullRefresh: false  # Default true: full refresh on every update; false allows partial refreshes (see ARCHITECTURE.md)
    # temperatureProfile: a  # How the firmware drives the panel: default, a or b (see ARCHITECTURE.md)
    # token: …  # Only for a device paired with another server: its existing token, used instead of a derived one
